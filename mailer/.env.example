# Copy to .env and fill in. Never commit the real file.
# Shared secret with the portal (same value as the portal's MAILER_SECRET). Generate: openssl rand -hex 32
MAILER_SECRET=
# Public host name of this server. Its A record must point to this server's IP, and the IP's reverse DNS (PTR) must return this name.
MAILER_HOSTNAME=mail.example.com
# Domains you send From. Mail from any other domain is refused.
ALLOWED_FROM_DOMAINS=example.com
# Return-path domain for bounces. Point its MX record at MAILER_HOSTNAME.
BOUNCE_DOMAIN=bounces.example.com
# DKIM key made with: npm run dkim-keygen -- ra1 example.com ./keys
DKIM_DOMAIN=example.com
DKIM_SELECTOR=ra1
DKIM_PRIVATE_KEY_PATH=./keys/ra1.example.com.private.pem
# Where the mailer reports deliveries and bounces.
PORTAL_WEBHOOK_URL=https://portal.example.com/api/email/webhook
# Queue storage.
DATA_DIR=./data
# HTTP API (keep on localhost; put Caddy/nginx with HTTPS in front on port 443).
HTTP_HOST=127.0.0.1
HTTP_PORT=8025
# Bounce receiver (SMTP, port 25).
INBOUND_ENABLED=true
INBOUND_PORT=25
# Optional TLS for the bounce receiver (for example Caddy's or Let's Encrypt's certificate files).
# INBOUND_TLS_KEY_PATH=
# INBOUND_TLS_CERT_PATH=
# Warm-up: a new IP starts at WARMUP_START recipients per day and grows by WARMUP_GROWTH each day up to DAILY_LIMIT.
WARMUP_START=200
WARMUP_GROWTH=1.5
DAILY_LIMIT=100000
# Parallel SMTP connections overall and per recipient domain, and per-domain messages per minute.
CONCURRENCY=10
PER_DOMAIN_CONCURRENCY=2
PER_DOMAIN_PER_MINUTE=60
# Give up on a message after this many hours of temporary failures.
MAX_RETRY_HOURS=72
