# systemd unit. Install the mailer in /opt/ra-mailer (npm ci --omit=dev), create /opt/ra-mailer/.env, then:
#   sudo cp deploy/ra-mailer.service /etc/systemd/system/ && sudo systemctl enable --now ra-mailer
[Unit]
Description=RA Studio mailer (self-hosted outbound email)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ramailer
WorkingDirectory=/opt/ra-mailer
EnvironmentFile=/opt/ra-mailer/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/index.js
Restart=always
RestartSec=5
# Allows binding the bounce receiver to port 25 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ra-mailer/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
